!
version 15.1
no service timestamps log datetime msec
no service timestamps debug datetime msec
no service password-encryption
!
hostname Firewall-Router-0
!
!
!
!
!
!
!
!
no ip cef
no ipv6 cef
!
!
!
!
license udi pid CISCO2911/K9 sn FTX15248KBT-
!
!
!
!
!
!
!
!
!
!
!
spanning-tree mode pvst
!
!
!
!
!
!
interface GigabitEthernet0/0
 ip address 203.0.113.6 255.255.255.252
 ip nat outside
 duplex auto
 speed auto
!
interface GigabitEthernet0/1
 no ip address
 duplex auto
 speed auto
 shutdown
!
interface GigabitEthernet0/2
 no ip address
 duplex auto
 speed auto
 shutdown
!
interface FastEthernet0/0/0
 switchport access vlan 10
 switchport mode access
!
interface FastEthernet0/0/1
 switchport trunk allowed vlan 2-9,11-19,21-1001
 switchport mode trunk
!
interface FastEthernet0/0/2
 switchport access vlan 20
 switchport mode access
!
interface FastEthernet0/0/3
 switchport mode access
!
interface Vlan1
 no ip address
 shutdown
!
interface Vlan10
 mac-address 00d0.ba60.2601
 ip address 10.10.10.1 255.255.255.224
 ip nat inside
!
interface Vlan20
 mac-address 00d0.ba60.2602
 ip address 10.10.20.1 255.255.255.240
 ip access-group 110 out
!
interface Vlan30
 mac-address 00d0.ba60.2603
 ip address 10.10.30.1 255.255.255.192
!
interface Vlan40
 mac-address 00d0.ba60.2604
 ip address 10.10.40.1 255.255.255.0
!
interface Vlan99
 mac-address 00d0.ba60.2605
 ip address 10.10.99.1 255.255.255.240
!
ip nat inside source static tcp 10.10.10.10 443 203.0.113.6 443 
ip nat inside source static tcp 10.10.10.10 80 203.0.113.6 80 
ip classless
ip route 0.0.0.0 0.0.0.0 203.0.113.5 
!
ip flow-export version 9
!
!
access-list 110 deny ip 10.10.40.0 0.0.0.255 10.10.20.0 0.0.0.15
access-list 110 permit tcp 10.10.10.0 0.0.0.31 10.10.20.0 0.0.0.15
access-list 110 permit ip any any
!
!
!
!
!
line con 0
!
line aux 0
!
line vty 0 4
 login
!
!
!
end
